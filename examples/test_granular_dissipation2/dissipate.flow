
shell mkdir dumpfiles
variable grainDiameter equal 0.005
variable grainDensity equal 3000
variable random_seed equal 10007 
variable Lx equal v_grainDiameter*4.01
variable Ly equal v_grainDiameter*4.01
variable Lz equal v_grainDiameter*4.01
variable writeFrequency equal 2000000
variable timeStep equal 1e-7
timestep ${timeStep}

comm_modify mode single vel yes
variable sizefrac equal v_grainDiameter/2
neighbor ${sizefrac} nsq
units si
boundary p p p
atom_style sphere
atom_modify	map array sort 0 0
newton off
neigh_modify delay 0 
region regWhole block 0 ${Lx} 0 ${Ly} 0 ${Lz} units box
create_box 4 regWhole
variable eps equal v_grainDiameter/100
region regionForGrains block ${eps} ${Lx} ${eps} ${Ly} ${eps} ${Lz} units box
variable lattice_size equal v_grainDiameter*1.001
lattice sc ${lattice_size}
create_atoms 1 region regionForGrains
group the_grains type 1
set group the_grains diameter ${grainDiameter} density ${grainDensity}

pair_style granular
#pair_coeff * * hooke 1e5 1e-2 tangential linear_nohistory 0.1 0.2 damping velocity dissipative_heat 1.0 1.0 1.0
#pair_coeff * * hooke 1e5 1e-2 tangential linear_nohistory 0.1 0.2 damping mass_velocity dissipative_heat 1.0 1.0 1.0
#pair_coeff * * hooke 1e5 1e-5 tangential linear_history 1e4 0.1 0.2 damping velocity dissipative_heat 1.0 1.0 1.0
pair_coeff * * hertz 1.0e6 50.0 tangential mindlin 1.0e5 1.0 0.4 limit_damping dissipative_heat 1.0 1.0 1.0

compute KinEng all ke
compute RotKinEng_atom all erotate/sphere/atom
compute RotKinEng all reduce sum c_RotKinEng_atom
compute pairs all pair/local p13 p14 p15
compute AccumDiss all reduce sum c_pairs[*] inputs local
thermo_style custom step atoms time c_KinEng c_RotKinEng c_AccumDiss[1] c_AccumDiss[2] c_AccumDiss[3]
thermo ${writeFrequency}
fix integ the_grains nve/sphere
run 0 
variable init_temp equal PI*v_grainDensity*v_grainDiameter^3/6*0.01^2/1.38e-23 # m*v_rms^2/3/k_B
velocity all create ${init_temp} 10007
variable avewindow equal 10000
fix 1 all ave/time 1 ${avewindow} ${avewindow} c_KinEng c_RotKinEng c_AccumDiss[1] c_AccumDiss[2] c_AccumDiss[3] file energy.dat
dump dum_all all custom ${writeFrequency} dumpfiles/all_* id radius x y z vx vy vz omegax omegay omegaz
info variables out overwrite info
variable runUntil equal floor(v_writeFrequency*20)
run ${runUntil}
